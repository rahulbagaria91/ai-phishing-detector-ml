{
  "manifest_version": 3,
  "name": "AI Phishing Detector",
  "version": "3.0",
  "description": "Real-time AI-powered phishing detection using Machine Learning (Random Forest, 99.99% accuracy)",
  "permissions": [
    "activeTab",
    "tabs",
    "notifications",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Phishing Detector",
    "default_icon": {
      "16":  "icon.png",
      "48":  "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16":  "icon.png",
    "48":  "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
